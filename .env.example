GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
CONTEXT_DEV_API_KEY=
# Aiven Service URI. Any sslmode in the URL is ignored; TLS is set up in lib/db.ts.
DATABASE_URL=
# Aiven CA certificate (Aiven console -> Overview -> CA certificate). Without it TLS is not verified.
# Local: a path. Vercel: paste the full PEM text (with BEGIN/END lines) as the value.
DATABASE_CA_CERT=./certs/ca.pem
GEMMA_BASE_URL=http://localhost:11434/v1
GEMMA_MODEL=gemma3:12b
GEMMA_API_KEY=ollama
# Embedding model for meaning search (default embeddinggemma; pull it on the same Ollama)
GEMMA_EMBED_MODEL=
VERDA_API_KEY=
# Shared password for the organiser workspace (/organiser, /api/organiser, organiser actions).
# Not set: open in local development, LOCKED in production. Set it on the host before sharing the URL.
ORGANISER_PASSWORD=
# Signs session cookies (companies, organisers). Optional; any long random string.
SESSION_SECRET=
# Reminder e-mails after meetings via Resend (https://resend.com). Not set: previews in the app.
RESEND_API_KEY=
EMAIL_FROM=bridgy <onboarding@resend.dev>
# Demo: send every e-mail to this one inbox (the demo people have synthetic addresses).
DEMO_EMAIL_TO=
# 1 = allow the demo reset buttons (reset a review, start a company card over). Not set: on in development, off in production.
DEMO_MODE=
# 1 = every service wrapper returns stub data (demo without network)
USE_STUBS=
# 1 = /api/health makes a real call to Context.dev (off: only checks the key is set)
HEALTH_PROBE_CONTEXTDEV=
